<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    android:elevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Usuario + tipo de publicación -->
        <LinearLayout android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_user"
                android:background="@drawable/circle"
                android:scaleType="centerCrop"/>

            <LinearLayout android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvUserName"
                    android:text="Tincho Sosa"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvLocation"
                    android:text="Formosa"
                    android:textSize="12sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvTag"
                android:text="Reencuentro"
                android:textColor="@color/white"
                android:backgroundTint="@color/purple_500"
                android:background="@drawable/rounded_tag"
                android:padding="4dp"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Texto -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Texto de ejemplo de publicación."/>

        <!-- Imagen -->
        <ImageView
            android:id="@+id/imgPost"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:src="@drawable/cat_placeholder"/>

        <!-- Reacciones -->
        <TextView
            android:id="@+id/tvReactionSummary"
            android:text="a 20 personas les alegra este reencuentro"
            android:textSize="12sp"
            android:layout_marginTop="6dp"/>

        <LinearLayout
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="space-between">

            <LinearLayout android:orientation="horizontal">
                <ImageView android:src="@drawable/ic_heart" android:layout_width="24dp" android:layout_height="24dp"/>
                <ImageView android:src="@drawable/ic_comment" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="8dp"/>
            </LinearLayout>

            <ImageView android:src="@drawable/ic_bookmark" android:layout_width="24dp" android:layout_height="24dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
